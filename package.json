{
  "name": "enterprisenet-access-portal",
  "version": "1.0.0",
  "description": "EnterpriseNet Access Portal - Fullstack Console",
  "type": "module",
  "main": "server/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node server/src/scripts/setup.js",
    "dev": "concurrently \"node --watch server/src/index.js\" \"cd client && npm run dev\"",
    "build": "cd client && npm run build",
    "start": "cross-env NODE_ENV=production node server/src/index.js",
    "test": "vitest run server/src/tests",
    "test:e2e": "cd client && npx playwright test",
    "verify": "node server/src/scripts/verify.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
}
