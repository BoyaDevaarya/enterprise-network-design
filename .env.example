# EnterpriseNet Access Portal Environment Variables Configuration Example

# Server listening port (default: 4000)
PORT=4000

# Environment mode (development | production | test)
NODE_ENV=development

# JWT Signing Secret Key (REQUIRED in production mode!)
JWT_SECRET=super-secret-dev-key-change-in-production

# Custom Persistent Data Directory (default: server/data)
DATA_DIR=server/data

# CORS Allowed Origin for standalone frontend dev server
CORS_ORIGIN=http://localhost:5173
